{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowJs": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": ["node"], "lib": ["ES2022", "DOM"]
  },
  "include": ["index.mjs", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
