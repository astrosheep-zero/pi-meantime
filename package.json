{
  "name": "pi-meantime",
  "version": "0.5.0",
  "description": "Pure Pi 1.3 extension: managed bash and typed tool proxies with cooperative background execution",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "files": [
    "index.mjs",
    "src",
    "scripts",
    "test",
    "tsconfig.json",
    "README.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:pi": "node --experimental-strip-types scripts/pi-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3",
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
