{
  "name": "pi-meantime",
  "version": "0.6.2",
  "description": "Pi 1.3 original-name tools with transparent cooperative background execution",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "files": [
    "index.mjs",
    "src",
    "scripts",
    "test",
    "tsconfig.json",
    "README.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "test:pi": "node --experimental-strip-types scripts/pi-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "typescript": "5.8.3",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  }
}
